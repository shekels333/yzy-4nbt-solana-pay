# Server
PORT=8787
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:8787
# Production: HTTPS origin for your pay host (no trailing slash), e.g. https://pay.yourdomain.com
# Railway volume → DATA_DIR=/data
DATA_DIR=./data

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Required: destination for YzY SPL transfers (your receive wallet)
MERCHANT_WALLET=
# Shared YzY (4NBT) community mint — change only if you accept a different token
YZY_MINT=4NBTf8PfLH4oLFnwf3knv46FY9i5oXjDxffCetXRpump
YZY_DECIMALS=6

# Fallback YzY amount when client omits amountYzy and usdAmount (prefer usdAmount on each intent)
DEFAULT_AMOUNT_YZY=1
PRODUCT_USD=6
LABEL=YzY Store
MESSAGE=Pay with YzY

# Live USD→YzY quote refresh
QUOTE_REFRESH_MS=3000
SLIPPAGE_BPS=100

# DexScreener oracle
MIN_PAIR_LIQUIDITY_USD=0
MAX_PRICE_DEVIATION_BPS=500
PRICE_HISTORY_SIZE=5
PRICE_HISTORY_MS=120000

# Shopify Admin API
# Prefer Dev Dashboard app (client credentials, ~24h tokens auto-refreshed):
#   scopes: write_draft_orders, read_draft_orders, read_products
SHOPIFY_SHOP=yourshop.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10

# Comma-separated storefront origins allowed to POST /intents (plus localhost)
# Example: https://yourshop.com,https://www.yourshop.com,https://yourshop.myshopify.com
CORS_ORIGINS=

# Poller / intents
POLL_INTERVAL_MS=4000
INTENT_TTL_MS=1200000

# Public checkout caps
MAX_QUANTITY=20
MAX_USD_TOTAL=500
INTENT_ADMIN_SECRET=

# Abuse controls
RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW_MS=60000
MAX_PENDING_INTENTS=100
MAX_PENDING_PER_EMAIL=5
